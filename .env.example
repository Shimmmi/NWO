# --- Local dev (dynamodb-local) ---
NODE_ENV=development
AUTH_SECRET=change-me-to-random-32-byte-hex
PORT=3000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=ru-central1
DYNAMODB_ENDPOINT=http://127.0.0.1:8020
COOKIE_SECURE=false

# Пусто в dev — проверка Origin отключена. В проде список обязателен.
# ALLOWED_ORIGINS=https://example.com

# Redis необязателен: без REDIS_URL всё работает на in-memory сторе (lib/redis/client.ts).
# REDIS_URL=redis://127.0.0.1:6379

# --- Production (Yandex Cloud Document API) ---
# Copy .env.docker.prod.example → .env.docker.prod on server.
# Omit DYNAMODB_ENDPOINT — SDK uses https://docapi.yandexcloud.net
# REDIS_URL=redis://redis:6379
# COOKIE_SECURE=true
#
# NEXT_PUBLIC_WS_URL удалена: адрес WebSocket вычисляется в браузере из location,
# соединение same-origin через /nwo/ws.
# WS_PORT удалена: отдельного WS-процесса больше нет, всё на PORT.
