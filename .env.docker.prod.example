# Production env for docker-compose.prod.yml — copy to .env.docker.prod on server (chmod 600).
# Do NOT commit .env.docker.prod to git.
#
# Option A (recommended): Yandex Cloud Document API — run ./scripts/setup-yandex-dynamodb.sh
# Option B (interim): internal dynamodb-local via docker network (see defaults below)

NODE_ENV=production
AUTH_SECRET=generate-with-openssl-rand-hex-32
PORT=3000

# Redis из docker-compose.prod.yml. Хостовый Redis использовать нельзя: он забинден
# на 127.0.0.1 (недостижим из docker-сети), его db0 занят waifu-bot,
# а maxmemory-policy там noeviction.
REDIS_URL=redis://redis:6379

# --- Option A: Yandex Cloud (uncomment and fill after setup-yandex-dynamodb.sh) ---
# AWS_ACCESS_KEY_ID=your-yandex-sa-access-key-id
# AWS_SECRET_ACCESS_KEY=your-yandex-sa-secret-access-key
# AWS_REGION=ru-central1
# DYNAMODB_ENDPOINT=https://docapi.serverless.yandexcloud.net/ru-central1/<folder-id>/<database-id>

# --- Option B: internal dynamodb-local (default until Yandex is configured) ---
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=ru-central1
DYNAMODB_ENDPOINT=http://dynamodb-local:8000

COOKIE_SECURE=true

# Обязательно в проде: Same-Origin Policy на WebSocket не действует, и без
# белого списка апгрейд примется с любого стороннего сайта вместе с кукой.
ALLOWED_ORIGINS=https://example.com

# NEXT_PUBLIC_WS_URL удалена: адрес WebSocket вычисляется в браузере из location.
# WS_PORT удалена: отдельного WS-процесса нет, HTTP и WS живут на PORT.
